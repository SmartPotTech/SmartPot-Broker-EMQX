# Cuenta de servicio del broker: la usa la API para conectarse. Se siembra como superusuario en la base
# interna de EMQX. Mínimo 16 caracteres; solo se aplica en el primer arranque (volumen vacío).
MQTT_ADMIN_USERNAME=smartpot-api
MQTT_ADMIN_PASSWORD=<MQTT_ADMIN_PASSWORD_MIN_16_CHARS>

# Secreto compartido con la API: EMQX lo envía en la cabecera x-smartpot-broker-token al autenticar
# dispositivos, y la API rechaza cualquier llamada sin él.
MQTT_AUTHN_TOKEN=<SHARED_AUTHN_TOKEN>
# Endpoint interno de autenticación de la API (por defecto apunta al servicio api-smartpot).
MQTT_AUTHN_URL=http://api-smartpot:8091/internal/mqtt/authn

# Clave de la API REST de EMQX: la usa la API para desconectar sesiones al rotar o borrar la clave de un cultivo.
MQTT_BROKER_API_KEY=<EMQX_REST_API_KEY>
MQTT_BROKER_API_SECRET=<EMQX_REST_API_SECRET>

# Hilos del BEAM (schedulers). 1 o 2 bastan para la carga de SmartPot.
MQTT_SCHEDULERS=2
# Conexiones simultáneas permitidas en el listener TLS público.
MQTT_TLS_MAX_CONNECTIONS=200
